APP_NAME="DocEditor"
# Full public URL of your app — used to build the password-reset link in emails.
# No trailing slash. Example: https://doceditor.example.com
APP_URL=https://example.com

# ── Encryption key (REQUIRED for data encryption) ──────────────────────────
# Generate with: php database/generate_key.php
# 32-byte random key encoded as base64. KEEP THIS SECRET AND BACKED UP.
# Losing this key = losing access to ALL encrypted data permanently.
APP_KEY=
# On a public server ALWAYS use: APP_ENV=production and APP_DEBUG=false
# (debug mode prints error details — including database information — in the browser)
APP_ENV=production
APP_DEBUG=false

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=doceditor
DB_USERNAME=doceditor_user
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Minutes of inactivity before a login session expires (default 120)
SESSION_LIFETIME=120

# Set to true ONLY if the site sits behind a reverse proxy / CDN (Cloudflare, nginx...)
# that sets X-Forwarded-For / X-Forwarded-Proto. Leave false otherwise.
TRUSTED_PROXY=false

# ── Staying signed in ("Keep me signed in on this device") ─────────────────
# A remembered browser is signed back in silently when its PHP session ends. Every use pushes the
# expiry this many days ahead, so people who use the app never have to sign in again.
REMEMBER_DAYS=180
# Absolute lifetime of a remembered device in days, however often it is used. 0 = no limit.
REMEMBER_MAX_DAYS=0
# The device's secret key is replaced at least this often while the app is open.
REMEMBER_ROTATE_MINUTES=60
# true = a remembered device must keep (roughly) the same network: IPv4 /24, IPv6 /48.
# Stricter, but people on phones or laptops moving between Wi-Fi and 4G will have to sign in again.
REMEMBER_BIND_IP=false

# ── Two-factor authentication (email OTP) ──────────────────────────────────
# Set to false to disable 2FA entirely (useful during local development).
TWO_FACTOR_ENABLED=true
# How long the 6-digit code is valid (minutes). Default: 10.
OTP_LIFETIME_MINUTES=10
# How long a password-reset link is valid (minutes). Default: 60.
RESET_TOKEN_MINUTES=60

# ── Email (SMTP) ────────────────────────────────────────────────────────────
# Set MAIL_DRIVER=log during development to write emails to the app log
# instead of sending them. The code will appear in Settings → Logs.
MAIL_DRIVER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
# tls = STARTTLS (port 587)  |  ssl = SSL/TLS wrapper (port 465)  |  none
MAIL_ENCRYPTION=tls
MAIL_USERNAME=noreply@example.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="DocEditor"
