{
  "id": "proforma",
  "version": 1,
  "name": "Proforma Invoice",
  "description": "Proforma invoice for customs or advance payment. Not a tax document.",
  "icon": "fa-file-invoice-dollar",
  "color": "#d97706",
  "numbering": { "prefix": "PRO" },
  "statuses": ["draft", "final"],
  "sections": {
    "header":   { "label": "Document Header", "open": true },
    "customer": { "label": "Bill To",         "open": true },
    "items":    { "label": "Line Items",       "open": true },
    "totals":   { "label": "Totals & VAT",    "open": false },
    "text":     { "label": "Notes & Terms",   "open": false },
    "bank":     { "label": "Bank Details",    "open": false },
    "issuer":   { "label": "Issuer",          "open": false }
  },
  "features": {
    "show_prices":      true,
    "show_totals":      true,
    "show_bank":        true,
    "show_vat":         true,
    "show_quote_ref":   false,
    "show_po":          true,
    "show_due_date":    true,
    "show_service_date":false,
    "show_tracking":    false,
    "show_delivery":    false,
    "show_signature":   false
  },
  "defaults": {
    "balance_label": "TOTAL",
    "vat_mention":   "This is a proforma invoice and is not a VAT invoice.",
    "terms":         "Payment must be received before shipment."
  }
}
